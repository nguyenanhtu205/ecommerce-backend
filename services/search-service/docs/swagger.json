{
    "swagger": "2.0",
    "info": {
        "title": "Search Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/search",
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "search"
                ],
                "summary": "Full-text search products",
                "parameters": [
                    {
                        "type": "string",
                        "description": "search keyword",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "minimum price",
                        "name": "priceMin",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "maximum price",
                        "name": "priceMax",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "category id",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "price|rating|soldCount, append :asc or :desc, e.g. price:asc",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page number, starting from 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "items per page",
                        "name": "size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.SearchResponse"
                        }
                    }
                }
            }
        },
        "/suggest": {
            "get": {
                "tags": [
                    "search"
                ],
                "summary": "Autocomplete product name",
                "parameters": [
                    {
                        "type": "string",
                        "description": "prefix to suggest against",
                        "name": "q",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.SuggestResponse"
                        }
                    }
                }
            }
        },
        "/trending": {
            "get": {
                "tags": [
                    "search"
                ],
                "summary": "Top trending search keywords",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "number of keywords to return",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.TrendingResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.CategoryPathItem": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "domain.ProductListing": {
            "type": "object",
            "properties": {
                "brand": {
                    "type": "string"
                },
                "categoryPath": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.CategoryPathItem"
                    }
                },
                "description": {
                    "type": "string"
                },
                "discountPercent": {
                    "type": "integer"
                },
                "isOutOfStock": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "originalPriceMin": {
                    "type": "integer"
                },
                "priceMax": {
                    "type": "integer"
                },
                "priceMin": {
                    "type": "integer"
                },
                "productId": {
                    "type": "string"
                },
                "ratingAverage": {
                    "type": "number"
                },
                "ratingCount": {
                    "type": "integer"
                },
                "searchableSpecs": {
                    "type": "string"
                },
                "shopId": {
                    "type": "string"
                },
                "shopName": {
                    "type": "string"
                },
                "soldCount": {
                    "type": "integer"
                },
                "stockTotal": {
                    "type": "integer"
                },
                "syncedAt": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "thumbnailUrl": {
                    "type": "string"
                }
            }
        },
        "http.SearchResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.ProductListing"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "http.SuggestResponse": {
            "type": "object",
            "properties": {
                "suggestions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "http.TrendingItem": {
            "type": "object",
            "properties": {
                "keyword": {
                    "type": "string"
                },
                "score": {
                    "type": "number"
                }
            }
        },
        "http.TrendingResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.TrendingItem"
                    }
                }
            }
        }
    }
}