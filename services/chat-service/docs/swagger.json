{
    "swagger": "2.0",
    "info": {
        "title": "Chat Service API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/chat/conversations": {
            "get": {
                "tags": [
                    "chat"
                ],
                "summary": "List conversations of the current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Conversation"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Buyer starts (or reuses) a conversation with a shop — buyerId is taken from",
                "parameters": [
                    {
                        "description": "shopId",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.createConversationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Conversation"
                        }
                    }
                }
            }
        },
        "/chat/conversations/{id}/messages": {
            "get": {
                "tags": [
                    "chat"
                ],
                "summary": "Paginated message history of a conversation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "conversationId",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "page number, starting from 1",
                        "name": "page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Message"
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Send a message via REST — also the entrypoint reused by the WebSocket handler",
                "parameters": [
                    {
                        "type": "string",
                        "description": "conversationId",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "message content",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.sendMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Message"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/chat/conversations/{id}/read": {
            "post": {
                "tags": [
                    "chat"
                ],
                "summary": "Mark all messages from the other party as read",
                "parameters": [
                    {
                        "type": "string",
                        "description": "conversationId",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/chat/ws": {
            "get": {
                "tags": [
                    "chat"
                ],
                "summary": "WebSocket endpoint for real-time chat on a conversation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "conversationId to subscribe to",
                        "name": "conversationId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Conversation": {
            "type": "object",
            "properties": {
                "buyerId": {
                    "type": "string"
                },
                "buyerUnreadCount": {
                    "type": "integer"
                },
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "lastMessage": {
                    "type": "string"
                },
                "lastMessageAt": {
                    "type": "string"
                },
                "lastMessageSenderType": {
                    "$ref": "#/definitions/domain.SenderType"
                },
                "sellerUnreadCount": {
                    "type": "integer"
                },
                "shopId": {
                    "type": "string"
                }
            }
        },
        "domain.Message": {
            "type": "object",
            "properties": {
                "attachmentMediaAssetIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "content": {
                    "type": "string"
                },
                "conversationId": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "isAutoGenerated": {
                    "type": "boolean"
                },
                "isRead": {
                    "type": "boolean"
                },
                "senderType": {
                    "$ref": "#/definitions/domain.SenderType"
                }
            }
        },
        "domain.SenderType": {
            "type": "string",
            "enum": [
                "buyer",
                "shop"
            ],
            "x-enum-varnames": [
                "SenderBuyer",
                "SenderShop"
            ]
        },
        "http.attachmentInput": {
            "type": "object",
            "properties": {
                "mediaAssetId": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                }
            }
        },
        "http.createConversationRequest": {
            "type": "object",
            "properties": {
                "shopId": {
                    "type": "string"
                }
            }
        },
        "http.sendMessageRequest": {
            "type": "object",
            "properties": {
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.attachmentInput"
                    }
                },
                "content": {
                    "type": "string"
                }
            }
        }
    }
}